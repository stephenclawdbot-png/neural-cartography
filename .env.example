# ---------------------------------------------------------------------------
# Luminos-clone environment configuration
# Copy this file to `.env.local` (local dev) or set these in Vercel > Settings >
# Environment Variables. Every value is OPTIONAL — with none set, the scanner
# runs in DEMO mode and serves realistic sample verdicts so the site works out
# of the box.
# ---------------------------------------------------------------------------

# Standard Solana JSON-RPC endpoint. Enables LIVE holder-distribution analysis
# (concentration, mint/freeze authority, top-holder graph). A public endpoint
# works but is heavily rate limited — use a dedicated provider for real traffic.
# Examples:
#   https://api.mainnet-beta.solana.com          (public, rate limited)
#   https://mainnet.helius-rpc.com/?api-key=XXX  (Helius RPC)
SOLANA_RPC_URL=

# Helius API key. When set, unlocks DEEP bundling analysis: per-holder funding
# sources, common-funder detection, fresh-wallet clustering, and mixer/low-trust
# exchange funding heuristics. Get one at https://helius.dev
HELIUS_API_KEY=

# Optional: force demo mode even if an RPC URL is present (useful for previews).
# Set to "true" to always serve sample data.
LUMINOS_DEMO_MODE=
